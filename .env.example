# Personal Finance Advisor Bot - Environment Configuration

# Flask Application Secret Key
SECRET_KEY=super-secret-key-finance-bot-change-in-prod-2025

# JWT Secret Key for authenticating API tokens
JWT_SECRET_KEY=jwt-secret-key-personal-finance-advisor-prod

# Database URL (SQLite default; PostgreSQL supported e.g. postgresql://user:password@localhost:5432/finance_db)
DATABASE_URL=sqlite:///finance.db

# Optional AI Key (If omitted, system seamlessly runs built-in Rule-Based AI Advisor Engine)
# AI_API_KEY=your_gemini_or_openai_api_key_here
# AI_PROVIDER=gemini

# Server Port
PORT=5000
FLASK_DEBUG=True
